    "autoplay": {
      "title": "Autoplay",
      "enable": "Enable autoplay",
      "enable_help": "When enabled, Akagi performs the bot's chosen action for you. Requires the Chromium capture mode and a running game tab. On Mahjong Soul the action is clicked on the board; on Tenhou it is sent directly over the game connection; on Riichi City it is injected as the client's own protocol frames through the MITM proxy (no Chromium needed).",
      "platform_note": "These click-timing knobs apply to Mahjong Soul only. Tenhou and Riichi City autoplay send the action over the game connection and do not click, so they use the thinking-time model below but none of the settings above.",
      "rc_warning_desc": "Autoplay on Riichi City is implemented by injecting protocol frames through the MITM proxy. This approach still has open safety concerns and may get your account banned. Use it at your own risk.",
      "rc_warning_ack": "I understand the risk",
      "pre_click_delay_min": "Pre-click delay (min, ms)",
      "pre_click_delay_max": "Pre-click delay (max, ms)",
      "inter_click_delay": "Inter-click delay (ms)",
      "hover_delay": "Hover delay before press (ms)",
      "hover_delay_hint": "Mouse must hover for ≥100ms before mousedown for Mahjong Soul to register a tile click. Lower values risk dropped clicks.",
      "click_hold": "Click hold (ms)",
      "verify_input": "Click verification timeout (ms)",
      "verify_input_hint": "After clicking, wait this long for the game client to send its own input command. If nothing arrives the click was swallowed and is pressed again. 0 disables verification.",
      "click_retries": "Click retries",
      "click_retries_hint": "How many times a swallowed click is pressed again. Retries hold the button longer (and nudge the cursor) instead of repeating the same press. 0 only logs.",
      "reload_after_failures": "Pause after failed decisions",
      "reload_after_failures_hint": "Pause after this many unsuccessful decisions. Never refresh the page; 0 disables the threshold.",
      "dealer_first_discard_extra_delay": "Dealer first-discard extra delay (ms)",
      "dealer_first_discard_extra_delay_hint": "Mahjong Soul plays a hand-sort animation when the dealer is dealt all 14 tiles. Clicks during the animation are dropped. ~2000ms covers most devices.",
      "delay_mode": "Delay model",
      "delay_mode_lua": "Lua script (human-like, recommended)",
      "delay_mode_legacy": "Legacy (fixed random delay)",
      "delay_mode_lua_help": "Delays come from delay.lua next to the config file, generated with a human-like model calibrated against ranked-game data on first use. Edit it freely — it hot-reloads on save; delete it to restore the default. If the script errors, a built-in model takes over.",
      "min_delay": "Minimum delay (ms)",
      "min_delay_hint": "Safety floor for every action: Mahjong Soul needs time to render the UI, and a click issued too early is silently lost. Applies in both modes and cannot be undercut by the script.",
      "min_button_delay": "Minimum button delay (ms)",
      "min_button_delay_hint": "Higher floor for chi/pon/kan/ron/skip/riichi buttons — they appear only after the discard animation plus their own pop-in, later than hand tiles. Raise this if buttons are still missing clicks."
    },
